<Window x:Class="DhcpServer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DHCP Server" Width="640" Height="800" MinWidth="560" MinHeight="520"
        Background="#F3F3F3" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
        <Style x:Key="Footer" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,6,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <!-- The big Start/Stop button: blue to start, red to stop. -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="12,0,0,0"
                            Content="{Binding StartButtonText}" IsEnabled="{Binding CanToggle}" Click="OnToggle" />
                    <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#B0B0B0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="#28B450" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666666" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubtitleIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#B55B00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0" Visibility="{Binding HasNotice, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Content="Dismiss" VerticalAlignment="Top"
                            Margin="12,0,0,0" Click="OnDismissNotice" />
                    <TextBlock Text="{Binding Notice}" Foreground="#C42B1C" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TabControl Margin="10" Background="#F3F3F3" BorderThickness="0">
            <TabItem Header="Setup" Padding="14,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,12,12">

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Network interface" />
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsStopped}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Interface" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Interfaces}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedInterface, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="This PC's address" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PcAddressSummary}" />
                                </Grid>
                                <DockPanel Margin="0,6">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Plain}" VerticalAlignment="Top"
                                            Content="{Binding CheckButtonText}" IsEnabled="{Binding CanCheck}" Click="OnCheck" />
                                    <TextBlock Text="{Binding CheckResultText}" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasCheckResult, Converter={StaticResource Visible}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E8E3E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CheckResultConflict}" Value="True">
                                                        <Setter Property="Foreground" Value="#B55B00" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Footer}"
                                   Text="Devices connected to this interface receive their addresses from this PC. Only run one DHCP server per network — turn off DHCP on your router first if it has one. Start checks for an existing server before it begins." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Windows Firewall" />
                        <Border Style="{StaticResource Card}">
                            <Button Style="{StaticResource Plain}" Content="Allow DHCP Server Through Windows Firewall" HorizontalAlignment="Left"
                                    Margin="0,6" Click="OnAllowFirewall" />
                        </Border>
                        <TextBlock Style="{StaticResource Footer}"
                                   Text="Windows Firewall blocks requests from devices until this app is allowed. Do this once (it needs administrator approval), or choose Allow access if Windows asks by itself. Without it, the server runs but no device receives an address." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Address pool" />
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsStopped}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="First address" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PoolStart, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pool size" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Width="90" HorizontalAlignment="Right" TextAlignment="Right"
                                             Text="{Binding PoolSizeText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Addresses handed out" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PoolRangeText}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lease time" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="120" HorizontalAlignment="Right"
                                              ItemsSource="{Binding LeaseTimes}" DisplayMemberPath="Key" SelectedValuePath="Value"
                                              SelectedValue="{Binding LeaseSeconds, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Sent to each device" />
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsStopped}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Router (optional)" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Router, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DNS servers (optional)" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Dns, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Footer}"
                                   Text="Leave both blank on an isolated network with no internet connection. Separate several DNS servers with commas, e.g. 1.1.1.1, 8.8.8.8." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Reserved addresses" />
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsStopped}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Reservations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Mac, UpdateSourceTrigger=PropertyChanged}" ToolTip="MAC address, e.g. aa:bb:cc:dd:ee:ff" />
                                                <TextBox Grid.Column="1" Margin="8,0" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP address" />
                                                <Button Grid.Column="2" Style="{StaticResource Plain}" Content="Remove" Click="OnRemoveReservation" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Plain}" Content="Add Reserved Address" HorizontalAlignment="Left"
                                        Margin="0,6" Click="OnAddReservation" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Footer}"
                                   Text="Enter a device's MAC address (aa:bb:cc:dd:ee:ff) on the left and the IP address it should always receive on the right. Everything else is assigned automatically from the pool." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Background" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Margin="0,6" Content="Open when I sign in to Windows" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" />
                                <CheckBox Margin="0,6" Content="Start the server when the app opens" IsChecked="{Binding StartOnLaunch, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Footer}" Text="{Binding BackgroundFooter}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding DevicesHeader}" Padding="14,6">
                <Grid Margin="8">
                    <ListView ItemsSource="{Binding LeaseRows}" BorderBrush="#E1E1E1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Address" Width="130" DisplayMemberBinding="{Binding Address}" />
                                <GridViewColumn Header="Device" Width="160" DisplayMemberBinding="{Binding Device}" />
                                <GridViewColumn Header="MAC address" Width="140" DisplayMemberBinding="{Binding Mac}" />
                                <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="{Binding NoLeasesText}" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoLeases, Converter={StaticResource Visible}}" />
                </Grid>
            </TabItem>

            <TabItem Header="Activity" Padding="14,6">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Plain}" Content="Clear" HorizontalAlignment="Right"
                            Margin="0,8,0,0" Click="OnClearLog" />
                    <ListBox ItemsSource="{Binding Log}" BorderBrush="#E1E1E1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#777777" Width="86" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
